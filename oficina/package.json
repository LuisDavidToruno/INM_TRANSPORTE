{
  "name": "sigti-oficina",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "SIGTI — cliente web de oficina. Sistema de diseño LOKI, contrato 0.3.3.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "verificar-tokens": "node scripts/verificar-tokens.mjs",
    "verificar": "npm run typecheck && npm run verificar-tokens && node scripts/generar-inventario.mjs --verificar",
    "generar-inventario": "node scripts/generar-inventario.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.90.2",
    "lucide-react": "1.32.0",
    "qrcode-generator": "^2.0.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "7.85.0",
    "react-router": "8.3.0",
    "sonner": "2.0.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@hookform/resolvers": "5.9.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.2.1"
  }
